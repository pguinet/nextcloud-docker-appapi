# ===========================================
# Configuration Nextcloud Docker
# ===========================================
# Copiez ce fichier vers .env et modifiez les valeurs
# cp .env.example .env && chmod 600 .env
# (scripts/install.sh le génère sinon : scripts/generate-env.sh)
#
# Une valeur qui contient des espaces ou un $ doit être entre apostrophes :
# Compose comme bash la lisent alors telle quelle. Sans protection, Compose la
# lit encore, mais un « source .env » casse.

# ===========================================
# Domaine
# ===========================================
NEXTCLOUD_DOMAIN=cloud.example.com

# ===========================================
# Filtrage IP (Caddy)
# ===========================================
# Adresses ou plages CIDR autorisees a joindre Nextcloud, separees par des
# espaces. Pensez a l'IPv6 : une box Free delegue par exemple un /56.
# Le reseau backend (conteneurs de la stack) est toujours autorise.
# Vide = aucun acces depuis Internet.
NEXTCLOUD_ALLOWED_IPS='203.0.113.10 2001:db8:1234:5600::/56'

# Sous-reseau du reseau backend, autorise par le filtre (sauf sa passerelle).
# A changer seulement s'il entre en conflit avec un reseau existant.
#NEXTCLOUD_BACKEND_SUBNET=172.18.0.0/16
#NEXTCLOUD_BACKEND_GATEWAY=172.18.0.1

# ===========================================
# Version Nextcloud
# ===========================================
# Variante PostgreSQL uniquement : la variante MariaDB construit son image
# depuis le Dockerfile (FROM nextcloud:35-apache).
# Voir https://hub.docker.com/_/nextcloud/tags
NEXTCLOUD_VERSION=32

# ===========================================
# Compte administrateur initial
# ===========================================
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD='ChangeMe_AdminPassword123!'

# ===========================================
# Base de données MariaDB (docker-compose.mariadb.yml, variante par défaut)
# ===========================================
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=ChangeMe_DbPassword456
MYSQL_ROOT_PASSWORD=ChangeMe_DbRootPassword789
# Cache InnoDB (défaut 1G, recommandé par Nextcloud). À réduire si la machine a peu de RAM.
#MARIADB_BUFFER_POOL_SIZE=1G

# ===========================================
# Base de données PostgreSQL (docker-compose.postgres.yml)
# ===========================================
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=ChangeMe_DbPassword456!

# ===========================================
# HaRP - AppAPI Reverse Proxy
# ===========================================
# Clé partagée entre HaRP et AppAPI (générer avec: openssl rand -hex 32)
HARP_SHARED_KEY=ChangeMe_HarpSharedKey789!

# ===========================================
# Configuration PHP (optionnel)
# ===========================================
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=10G

# ===========================================
# Chemin des données (optionnel)
# ===========================================
# Par défaut: ./data (relatif au docker-compose)
# Exemple: /data ou /mnt/storage/nextcloud
#DATA_PATH=/data

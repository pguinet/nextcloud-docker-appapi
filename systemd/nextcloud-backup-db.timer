[Unit]
Description=Sauvegarde quotidienne de la base Nextcloud
Documentation=https://github.com/pguinet/nextcloud-docker-appapi

[Timer]
# 3h00, dans la fenêtre de maintenance Nextcloud (1h-5h UTC) et avant les
# transferts de la journée.
OnCalendar=*-*-* 03:00:00
# Décale de quelques minutes pour ne pas démarrer pile à l'heure ronde,
# en même temps que tout le reste.
RandomizedDelaySec=10m
# Rattrape la sauvegarde si la machine était éteinte à l'heure prévue.
Persistent=true

[Install]
WantedBy=timers.target
